# --- Base de datos (PostgreSQL) ---
# Neon, Supabase, Railway o RDS. Debe incluir ?sslmode=require en la mayoría de proveedores.
DATABASE_URL="postgresql://usuario:password@host:5432/bite?sslmode=require"

# --- Autenticación del panel de administración ---
# Código de acceso de 10 dígitos que usará la Socia Directora / el equipo de auditoría.
# Se usa SOLO para generar el hash inicial en el seed; una vez sembrado, cámbialo
# desde el panel (Ajustes > Código de acceso), nunca quede el texto plano en el repo.
ADMIN_ACCESS_CODE="2026110701"

# Secreto para firmar la cookie de sesión del panel (JWT). Genera uno con:
# openssl rand -base64 48
ADMIN_SESSION_SECRET="reemplaza-esto-con-un-secreto-largo-y-aleatorio"

# --- Correo transaccional (Resend) ---
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Dominio verificado en Resend. Mientras no verifiques un dominio propio,
# Resend solo permite enviar a tu propia cuenta desde onboarding@resend.dev.
RESEND_FROM="BITE. <pedidos@tu-dominio.com>"

# --- General ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# IANA tz usado para calcular las franjas de entrega (no cambiar salvo que la operación se mueva de ciudad)
APP_TIMEZONE="America/Bogota"
