// Esquema de base de datos — BITE.
// PostgreSQL vía Prisma. Diseñado para trazabilidad total: cada orden conserva
// una copia de sus líneas y su historial de estados, aunque el producto cambie después.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductCategory {
  PAQUETES
  BEBIDAS
  DULCES
}

enum ProductStatus {
  DISPONIBLE
  PROXIMAMENTE
}

enum OrderStatus {
  PENDIENTE
  PREPARANDO
  LISTA
  ENTREGADA
  CANCELADA
}

enum ChatSender {
  ADMIN
  CUSTOMER
}

model Product {
  id         String          @id @default(cuid())
  name       String
  category   ProductCategory @default(PAQUETES)
  priceCop   Int             // precio en pesos colombianos, sin decimales
  stock      Int             @default(0)
  status     ProductStatus   @default(DISPONIBLE)
  imageUrl   String          // URL pública de la foto real del producto (nunca un emoji)
  active     Boolean         @default(true) // soft-delete: oculta del catálogo sin romper órdenes históricas
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  orderItems OrderItem[]

  @@index([status, active])
}

model Location {
  id        String      @id @default(cuid())
  name      String
  detail    String
  active    Boolean     @default(true) // solo las ubicaciones activas se ofrecen al cliente para elegir
  createdAt DateTime    @default(now())
  orders    Order[]

  @@index([active])
}

model Order {
  id            String      @id @default(cuid())
  code          String      @unique // código corto mostrado al cliente, ej. BITE-7K2PQ
  customerEmail String
  status        OrderStatus @default(PENDIENTE)
  totalCop      Int

  // Franja de entrega asignada (copiada en el momento del checkout)
  windowDay     Int      // 0=domingo … 6=sábado
  windowLabel   String   // ej. "12:15 – 13:10"
  windowStart   Int      // minutos desde medianoche
  windowEnd     Int

  location   Location @relation(fields: [locationId], references: [id])
  locationId String

  items        OrderItem[]
  statusEvents OrderStatusEvent[]
  messages     ChatMessage[]

  emailSentAt DateTime?
  emailError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id         String  @id @default(cuid())
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId    String
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId  String?
  nameAtSale String  // copia del nombre al momento de la compra (trazabilidad si el producto cambia o se borra)
  priceAtSale Int
  qty        Int

  @@index([orderId])
}

model OrderStatusEvent {
  id        String      @id @default(cuid())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  status    OrderStatus
  at        DateTime    @default(now())

  @@index([orderId])
}

// Fila única de configuración operativa (código de acceso del panel, etc.)
model AppSettings {
  id            Int      @id @default(1)
  adminCodeHash String   // bcrypt del código de acceso de 10 dígitos
  updatedAt     DateTime @updatedAt
}

// Chat privado por pedido. El cliente entra sin login (verifica correo +
// código de pedido en cada request); el panel de administración ve y
// responde todos los hilos. readByAdmin controla el contador de "sin leer".
model ChatMessage {
  id          String     @id @default(cuid())
  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  sender      ChatSender
  body        String
  readByAdmin Boolean    @default(false)
  createdAt   DateTime   @default(now())

  @@index([orderId, createdAt])
}

// Buzón de "quiero este producto" escrito libremente desde la tienda, sin
// pedido ni cuenta asociada — solo texto + fecha. El panel de administración
// las lista y las marca como leídas, igual que el chat de pedidos.
model ProductSuggestion {
  id          String   @id @default(cuid())
  body        String
  readByAdmin Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([readByAdmin])
}
